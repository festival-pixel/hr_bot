# Токен бота от @BotFather
BOT_TOKEN=your_bot_token_here

# ID администраторов (HR) через запятую
ADMIN_ID=111111111,222222222

# База данных.
# DB_HOST/DB_PORT ниже — для ЛОКАЛЬНОГО запуска (postgres в docker, бот на хосте).
# В docker-compose сервис "bot" переопределяет их на postgres:5432 автоматически.
DB_USER=postgres
DB_PASSWORD=change_me_to_a_strong_password
DB_HOST=localhost
DB_PORT=15432
DB_NAME=hr_bot_db

# Логи SQL (True — подробно, для отладки; на проде False)
DEBUG=False
